{
  "name": "duru",
  "version": "1.0.0",
  "description": "Every screen of your app, under every configuration — computes a screen map from source, including screens reachable only under certain settings and screens whose backing API is gone",
  "bin": {
    "duru": "src/cli.ts"
  },
  "scripts": {
    "extract": "node src/cli.ts extract",
    "rebuild": "node src/cli.ts rebuild",
    "test": "tsc --noEmit && tsc --noEmit -p tsconfig.browser-tests.json && node --test \"test/*.test.ts\""
  },
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  },
  "keywords": [
    "qa",
    "screen-map",
    "static-analysis",
    "coverage"
  ],
  "author": "Inte-H",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "@babel/traverse": "^7.29.8",
    "fast-xml-parser": "^5.11.2",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/babel__traverse": "7.28.0",
    "@types/node": "22.18.13",
    "playwright-core": "1.60.0"
  }
}
