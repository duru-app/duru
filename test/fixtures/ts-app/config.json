{
  "srcRoot": "client/src",
  "routesFile": [
    "Routes.tsx",
    "admin/AdminRoutes.tsx",
    "pages/PageRoutes.tsx",
    "pages/MailRoutes.tsx"
  ],
  "routeElements": [
    "Route"
  ],
  "routeConstant": "Option.ROUTE_PATH",
  "constants": {
    "Option": "_define/Option.ts",
    "Settings": "store/index.ts"
  },
  "apiModules": [
    "_ajax/AjaxFunc.ts"
  ],
  "bodyArgKeys": [
    "data"
  ],
  "settingsRoots": [
    "globalSettings"
  ],
  "settingsDefaults": {
    "globalSettings": {
      "constant": "Settings.appSettings"
    }
  },
  "roleIdentifiers": [
    "memberRole",
    "session['member.role']"
  ],
  "entryPaths": [
    "/home"
  ],
  "tests": [
    {
      "format": "vitest",
      "path": "results/vitest",
      "depth": "code"
    }
  ],
  "outDir": "out"
}
